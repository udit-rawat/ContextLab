# ContextLab — copy to .env and fill in. Three free keys, no card required.
# Non-secret config (pinned models, prices, token caps) lives in committed
# config so a reviewer can reproduce every number without these keys.

# --- Gemini: answerer (all 4 strategies) + embeddings ---
# Two keys from two SEPARATE Google accounts = two independent free-tier quotas.
# Primary is used for everything; fallback engages only on HTTP 429.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_account_1
GEMINI_API_KEY_FALLBACK=your_gemini_key_account_2

# --- Groq: LLM-as-judge only ---
# Deliberately a different model family from the answerer, so the judge
# cannot exhibit self-preference toward its own generations.
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
